{
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "ai/tests",
    "web/tests"
  ],
  "python.analysis.extraPaths": [
    "ai",
    "ai/tests",
    "."
  ],
  "python.terminal.activateEnvironment": true,
  "files.encoding": "utf8",
  "[powershell]": {
    "files.encoding": "utf8bom"
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true
  },
  "search.exclude": {
    "datasets": true,
    "data_raw": true,
    "runs": true,
    "reports": true,
    ".venv": true,
    ".smoke": true,
    "demo/samples": true
  },
  "files.watcherExclude": {
    "**/datasets/**": true,
    "**/data_raw/**": true,
    "**/runs/**": true,
    "**/.venv/**": true
  }
}
